NOTIFLY_PASSWORD=change-me # Empty: no login
NOTIFLY_SESSION_DAYS=30

NOTIFLY_PUBLIC_URL=http://localhost:8000

# Locale
NOTIFLY_CURRENCY=USD # BRL
NOTIFLY_LANGUAGE=en # pt-BR
NOTIFLY_COUNTRY=US # BR
TZ=UTC

# Checks (minutes)
NOTIFLY_DEFAULT_CHECK_INTERVAL_MINUTES=360
NOTIFLY_MIN_CHECK_INTERVAL_MINUTES=15

NOTIFLY_MIN_SECONDS_BETWEEN_SEARCHES=4
NOTIFLY_MAX_CONCURRENT_CHECKS=1

# NOTIFLY_SCHEDULER_ENABLED=false

# NOTIFLY_PROXY_URL=https://user:password@proxy.example.com:8443